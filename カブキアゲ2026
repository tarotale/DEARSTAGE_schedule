<!DOCTYPE html>

<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>UPGATE 2026 LIVE TRACKER</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Noto+Sans+JP:wght@400;700;900&display=swap" rel="stylesheet">
<style>
  :root {
    --wally: #ff2d55;
    --wally-dark: #8b0020;
    --zirco: #00d4ff;
    --zirco-dark: #004466;
    --bg: #0a0a0f;
    --panel: #12121a;
    --border: #1e1e2e;
    --text: #f0f0ff;
    --muted: #666688;
    --live-glow: rgba(255, 230, 0, 0.15);
    --live-color: #ffe600;
    --col-target:  #ffe600;
    --col-watch:   #ff8c00;
    --col-nora:    #dd0000;
    --col-omaitu:  #22c55e;
  }

- { margin: 0; padding: 0; box-sizing: border-box; }

body {
background: var(–bg);
color: var(–text);
font-family: ‘Noto Sans JP’, sans-serif;
min-height: 100vh;
overflow-x: hidden;
}

body::before {
content: ‘’;
position: fixed;
inset: 0;
background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.12) 2px, rgba(0,0,0,0.12) 4px);
pointer-events: none;
z-index: 1000;
}

header {
padding: 24px 20px 16px;
text-align: center;
background: linear-gradient(180deg, #0d0d1a 0%, transparent 100%);
border-bottom: 1px solid var(–border);
}

.event-title {
font-family: ‘Bebas Neue’, sans-serif;
font-size: clamp(28px, 6vw, 52px);
letter-spacing: 0.08em;
background: linear-gradient(135deg, #fff 0%, #aaa 100%);
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
line-height: 1;
}

.event-sub { font-size: 11px; letter-spacing: 0.3em; color: var(–muted); margin-top: 4px; text-transform: uppercase; }

.clock-container { margin-top: 16px; display: flex; align-items: center; justify-content: center; }

.clock {
font-family: ‘Bebas Neue’, sans-serif;
font-size: clamp(40px, 10vw, 72px);
letter-spacing: 0.05em;
color: var(–live-color);
text-shadow: 0 0 20px rgba(255,230,0,0.6), 0 0 40px rgba(255,230,0,0.3);
line-height: 1;
}

.date-label { font-size: 12px; color: var(–muted); letter-spacing: 0.15em; margin-top: 2px; }

.venues-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 16px;
padding: 20px 16px;
max-width: 980px;
margin: 0 auto;
}

@media (max-width: 640px) {
.venues-grid { grid-template-columns: 1fr; }
}

.venue-card {
border-radius: 12px;
overflow: hidden;
border: 1px solid var(–border);
background: var(–panel);
}

.venue-card.wally { border-color: var(–wally-dark); box-shadow: 0 0 24px rgba(255,45,85,0.15); }
.venue-card.zirco { border-color: var(–zirco-dark); box-shadow: 0 0 24px rgba(0,212,255,0.15); }

.venue-header {
padding: 14px 16px 12px;
display: flex;
align-items: center;
gap: 10px;
border-bottom: 1px solid var(–border);
}

.wally .venue-header { background: linear-gradient(135deg, rgba(255,45,85,0.2) 0%, transparent 100%); }
.zirco .venue-header { background: linear-gradient(135deg, rgba(0,212,255,0.2) 0%, transparent 100%); }

.venue-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.wally .venue-dot { background: var(–wally); box-shadow: 0 0 8px var(–wally); }
.zirco .venue-dot { background: var(–zirco); box-shadow: 0 0 8px var(–zirco); }

.venue-name { font-family: ‘Bebas Neue’, sans-serif; font-size: 20px; letter-spacing: 0.06em; line-height: 1; }
.wally .venue-name { color: var(–wally); }
.zirco .venue-name { color: var(–zirco); }

/* LIVE NOW */
.live-now-section {
padding: 14px 16px;
border-bottom: 1px solid var(–border);
background: var(–live-glow);
min-height: 82px;
display: flex;
flex-direction: column;
justify-content: center;
}

.live-label {
font-size: 9px;
letter-spacing: 0.3em;
color: var(–live-color);
font-weight: 700;
text-transform: uppercase;
display: flex;
align-items: center;
gap: 6px;
margin-bottom: 6px;
}

.live-dot-blink {
width: 6px; height: 6px; border-radius: 50%;
background: var(–live-color);
animation: blink 1s infinite;
box-shadow: 0 0 6px var(–live-color);
flex-shrink: 0;
}

@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.15} }

.live-artist { font-size: clamp(16px, 4vw, 24px); font-weight: 900; line-height: 1.2; color: #fff; }
.live-time-range { font-size: 11px; color: var(–muted); margin-top: 4px; }

/* POSITION TABLE */
.position-section {
padding: 12px 12px 10px;
border-bottom: 1px solid var(–border);
background: rgba(255,45,85,0.04);
}

.position-label {
font-size: 9px;
letter-spacing: 0.25em;
color: var(–wally);
font-weight: 700;
text-transform: uppercase;
margin-bottom: 8px;
}

.position-grid {
display: grid;
grid-template-columns: repeat(7, 1fr);
gap: 4px;
}

.position-col {
display: flex;
flex-direction: column;
align-items: center;
gap: 4px;
}

.position-header {
font-size: 8px;
color: var(–muted);
text-align: center;
padding-bottom: 3px;
border-bottom: 1px solid var(–border);
width: 100%;
}

.member-chip {
width: 100%;
border-radius: 4px;
padding: 4px 2px;
font-size: 9px;
font-weight: 700;
text-align: center;
line-height: 1.25;
min-height: 30px;
display: flex;
align-items: center;
justify-content: center;
word-break: break-all;
}

.chip-T { background: var(–col-target); color: #000; }
.chip-W { background: var(–col-watch);  color: #fff; }
.chip-N { background: var(–col-nora);   color: #fff; }
.chip-O { background: var(–col-omaitu); color: #000; }
.chip-  { background: rgba(255,255,255,0.05); color: var(–muted); font-weight: 400; }

.position-empty { font-size: 12px; color: var(–muted); font-style: italic; padding: 4px 0; }

.legend {
display: flex;
gap: 10px;
flex-wrap: wrap;
margin-top: 8px;
}

.legend-item { display: flex; align-items: center; gap: 4px; font-size: 9px; color: var(–muted); }
.legend-dot  { width: 8px; height: 8px; border-radius: 2px; }

/* NEXT */
.next-section { padding: 10px 16px; border-bottom: 1px solid var(–border); }
.next-label { font-size: 9px; letter-spacing: 0.25em; color: var(–muted); font-weight: 700; text-transform: uppercase; margin-bottom: 5px; }
.next-artist { font-size: 14px; font-weight: 700; color: #ccc; }
.next-time { font-size: 11px; color: var(–muted); }

/* SCHEDULE TOGGLE */
.schedule-toggle {
width: 100%;
background: none;
border: none;
padding: 10px 16px;
color: var(–muted);
font-size: 11px;
letter-spacing: 0.2em;
text-transform: uppercase;
cursor: pointer;
display: flex;
align-items: center;
justify-content: space-between;
font-family: ‘Noto Sans JP’, sans-serif;
transition: color 0.2s;
}
.schedule-toggle:hover { color: var(–text); }
.toggle-arrow { transition: transform 0.3s; }
.schedule-toggle.open .toggle-arrow { transform: rotate(180deg); }

.schedule-list { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; }
.schedule-list.open { max-height: 1200px; }

.schedule-item {
padding: 7px 16px;
display: flex;
align-items: center;
gap: 10px;
border-top: 1px solid rgba(255,255,255,0.04);
transition: background 0.15s;
}
.schedule-item:hover { background: rgba(255,255,255,0.03); }
.schedule-item.is-live { background: var(–live-glow); border-left: 2px solid var(–live-color); }
.schedule-item.is-past { opacity: 0.35; }

.s-time { font-size: 11px; color: var(–muted); min-width: 72px; letter-spacing: 0.05em; flex-shrink: 0; }
.s-artist { font-size: 13px; font-weight: 700; line-height: 1.3; }
.s-live-badge { margin-left: auto; font-size: 9px; letter-spacing: 0.15em; color: var(–live-color); font-weight: 700; flex-shrink: 0; }

footer { text-align: center; padding: 24px; color: var(–muted); font-size: 11px; letter-spacing: 0.15em; }
</style>

</head>
