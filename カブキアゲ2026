// 立ち位置データ: 列順 [下3, 下2, 下1, 0, 上1, 上2, 上3]
// カテゴリ: T=お目当て, W=見たがり, N=野良, O=おまいつ
const COLS = ["下3","下2","下1","0","上1","上2","上3"];

const WALLY_POS = {
  "あの日見たラッキースター": [
    ["あのすた","O"],["たかゆき","W"],["ダエイ","T"],["くー","T"],["のり","T"],["みずき","T"],["あのすた","O"]
  ],
  "SAKURADOLL": [
    ["コングラッチェ!","N"],["アプガ仮","W"],["アプガ仮","W"],["たかたろう","T"],["野良","N"],["野良","N"],["ChumToto","O"]
  ],
  "MISS MERCY": [
    ["コングラッチェ!","N"],["アプガ仮","W"],["アプガ仮","W"],["ドリキス","T"],["アプガ仮","W"],["アプガ仮","W"],["ChumToto","O"]
  ],
  "Dolly Kiss": [
    ["コングラッチェ!","N"],["7限目","W"],["7限目","W"],["はっと","T"],["7限目","W"],["7限目","W"],["7限目","W"]
  ],
  "Brave Mental Orchestra": [
    ["コングラッチェ!","N"],["7限目","W"],["7限目","W"],["7限目","W"],["7限目","W"],["7限目","W"],["7限目","W"]
  ],
  "アップアップガールズ(仮)": [
    ["アプガ仮","O"],["ゆっきー","T"],["つらら","T"],["しゅがちん","T"],["えみな","T"],["いっと","T"],["アプガ仮","O"]
  ],
  "7期目のフルール": [
    ["ChumToto","O"],["わああ","T"],["みそ","T"],["さとくん","T"],["じゃに","T"],["シベリア","T"],["7限目","O"]
  ],
  "HOTALOOP": [
    ["ChumToto","O"],["カラカラ(しゃ)","W"],["VVSIS","W"],["LOOP野良","N"],["HOTALOOP野良","N"],["カラカラ(と)","W"],["カラカラ","W"]
  ],
  "AZの理由": [
    ["ChumToto","O"],["カラカラ(しゃ)","W"],["VVSIS","W"],["VVSIS","W"],["VVSIS","W"],["カラカラ(と)","W"],["カラカラ","W"]
  ],
  "COLOR OF COLOR": [
    ["ChumToto","O"],["しゃ","T"],["けいすけ","T"],["りり","T"],["とみか","T"],["カラカラ","O"],["カラカラ","O"]
  ],
  "VViSiS": [
    ["ChumToto","O"],["まち","T"],["かめ","T"],["しょーと","T"],["コングラ","W"],["ヘイマミ","W"],["ChumToto","O"]
  ],
  "コングラッチェ！": [
    ["ChumToto","O"],["ChumToto","O"],["BOCCHI.","W"],["ギャオス","T"],["ヘイマミ","W"],["ChumToto","O"],["ChumToto","O"]
  ],
  "BOCCHI.": [
    ["ChumToto","O"],["ChumToto","O"],["ChumToto","O"],["とうや","T"],["ChumToto","O"],["ChumToto","O"],["ChumToto","O"]
  ],
  "Hey!Mommy!": [
    ["ChumToto","O"],["ChumToto","O"],["ChumToto","O"],["すばる","T"],["ChumToto","O"],["ChumToto","O"],["ChumToto","O"]
  ],
  "ChumToto": [
    ["ChumToto","O"],["だんご","T"],["ぬさ","T"],["ぼーの","T"],["たろてーる","T"],["ヒロ","T"],["ChumToto","O"]
  ],
};

function pad(n){ return String(n).padStart(2,'0'); }
function fmtTime(h,m){ return `${pad(h)}:${pad(m)}`; }
function toMin(h,m){ return h*60+m; }

function getNowMin(){
  const d = new Date();
  return d.getHours()*60 + d.getMinutes();
}

function findCurrent(sched, nowMin){
  for(let i=0;i<sched.length;i++){
    const [sh,sm,eh,em] = sched[i];
    if(nowMin >= toMin(sh,sm) && nowMin < toMin(eh,em)) return i;
  }
  return -1;
}

function findNext(sched, nowMin){
  for(let i=0;i<sched.length;i++){
    const [sh,sm] = sched[i];
    if(toMin(sh,sm) > nowMin) return i;
  }
  return -1;
}

function renderPositionGrid(groupName){
  const container = document.getElementById('position-grid-wally');
  const data = WALLY_POS[groupName];
  if(!data){
    container.innerHTML = '<div class="position-empty">立ち位置データなし</div>';
    return;
  }
  let html = '<div class="position-grid">';
  COLS.forEach((col, ci) => {
    const [name, cat] = data[ci] || ['', ''];
    html += `<div class="position-col">
      <div class="position-header">${col}</div>
      <div class="member-chip chip-${cat}">${name || '—'}</div>
    </div>`;
  });
  html += '</div>';
  container.innerHTML = html;
}

function buildScheduleList(venue){
  const sched = SCHEDULES[venue];
  const c = document.getElementById(`schedule-${venue}`);
  c.innerHTML = '';
  sched.forEach(([sh,sm,eh,em,name], i) => {
    const el = document.createElement('div');
    el.className = 'schedule-item';
    el.id = `si-${venue}-${i}`;
    el.innerHTML = `
      <div class="s-time">${fmtTime(sh,sm)}–${fmtTime(eh,em)}</div>
      <div class="s-artist">${name}</div>
      <div class="s-live-badge" id="badge-${venue}-${i}"></div>`;
    c.appendChild(el);
  });
}

function updateVenue(venue){
  const sched = SCHEDULES[venue];
  const nowMin = getNowMin();
  const curIdx = findCurrent(sched, nowMin);
  const nxtIdx = findNext(sched, nowMin);

  const liveArtistEl = document.getElementById(`live-artist-${venue}`);
  const liveTimeEl   = document.getElementById(`live-time-${venue}`);
  const liveSection  = document.getElementById(`live-${venue}`);

  if(curIdx >= 0){
    const [sh,sm,eh,em,name] = sched[curIdx];
    liveArtistEl.textContent = name;
    liveTimeEl.textContent   = `${fmtTime(sh,sm)} – ${fmtTime(eh,em)}`;
    liveSection.style.opacity = '1';
    if(venue === 'wally') renderPositionGrid(name);
  } else {
    const before = nowMin < toMin(sched[0][0], sched[0][1]);
    liveArtistEl.textContent = before ? '開場前' : '公演終了';
    liveTimeEl.textContent   = '';
    liveSection.style.opacity = '0.5';
    if(venue === 'wally'){
      document.getElementById('position-grid-wally').innerHTML =
        '<div class="position-empty">ライブ中のグループがありません</div>';
    }
  }

  const nextArtistEl = document.getElementById(`next-artist-${venue}`);
  const nextTimeEl   = document.getElementById(`next-time-${venue}`);
  if(nxtIdx >= 0){
    const [sh,sm,,,name] = sched[nxtIdx];
    nextArtistEl.textContent = name;
    nextTimeEl.textContent   = `${fmtTime(sh,sm)} 開演`;
  } else {
    nextArtistEl.textContent = '—';
    nextTimeEl.textContent   = '本日の公演は終了しました';
  }

  sched.forEach(([sh,sm,eh,em], i) => {
    const item  = document.getElementById(`si-${venue}-${i}`);
    const badge = document.getElementById(`badge-${venue}-${i}`);
    if(!item) return;
    item.classList.remove('is-live','is-past');
    badge.textContent = '';
    if(i === curIdx){ item.classList.add('is-live'); badge.textContent = '● LIVE'; }
    else if(nowMin >= toMin(eh,em)){ item.classList.add('is-past'); }
  });
}

function updateClock(){
  const d = new Date();
  document.getElementById('clock').textContent =
    `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
}

function toggleSchedule(venue){
  document.getElementById(`schedule-${venue}`).classList.toggle('open');
  document.getElementById(`toggle-${venue}`).classList.toggle('open');
}

function tick(){
  updateClock();
  updateVenue('wally');
  updateVenue('zirco');
}

buildScheduleList('wally');
buildScheduleList('zirco');
tick();
setInterval(tick, 1000);
</script>

